# Frontend → backend wiring for production (e.g. Vercel).
#
# The Go WebSocket backend must run somewhere that supports persistent
# WebSocket connections (Fly.io / Railway / Render / a VPS) — NOT Vercel.
# Point the frontend at it with these env vars (set them in the Vercel
# dashboard, Project → Settings → Environment Variables).

# WebSocket origin of the backend (note wss:// for HTTPS pages):
VITE_WS_BASE=wss://your-backend-host.example.com

# HTTP origin of the backend, used for image upload + serving (/upload, /uploads):
VITE_HTTP_BASE=https://your-backend-host.example.com
